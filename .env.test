# валидный конфиг при старте приложения.
BUNNY_STREAM_LIBRARY_ID=999999
BUNNY_STREAM_API_KEY=test-api-key
BUNNY_STREAM_CDN_HOSTNAME=vz-test.b-cdn.net
BUNNY_STREAM_TOKEN_KEY=test-token-key
BUNNY_WEBHOOK_KEY=test-webhook-key
BUNNY_PLAYBACK_TTL=21600
