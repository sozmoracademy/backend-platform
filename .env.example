# PORT/DATABASE_URL порты сдвинуты с дефолтных 3000/5432 — на машине разработки эти
# порты уже заняты другими локальными сервисами (см. docker-compose.yml). Если у вас
# 3000/5432 свободны, можно вернуть их и переставить порт в docker-compose.yml обратно.
NODE_ENV=development
PORT=3010

DATABASE_URL=postgresql://sozmor:sozmor@localhost:5434/sozmor?schema=public

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TTL=15m
REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=localhost

SCHOOL_TZ=Asia/Bishkek
SEED_TODAY=2026-08-18

THROTTLE_TTL=300
THROTTLE_LIMIT=100
