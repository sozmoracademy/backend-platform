# PORT/DATABASE_URL порты сдвинуты с дефолтных 3000/5432 — на машине разработки эти
# порты уже заняты другими локальными сервисами (см. docker-compose.yml). Если у вас
# 3000/5432 свободны, можно вернуть их и переставить порт в docker-compose.yml обратно.
NODE_ENV=development
PORT=3010

DATABASE_URL=postgresql://sozmor:sozmor@localhost:5434/sozmor?schema=public

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TTL=15m
REFRESH_TTL=7d

CORS_ORIGIN=http://localhost:5173,http://localhost:5174
COOKIE_DOMAIN=localhost

SCHOOL_TZ=Asia/Bishkek
SEED_TODAY=2026-08-18

THROTTLE_TTL=300
THROTTLE_LIMIT=100

# Bunny Stream — видеохостинг уроков (docs/TЗ.md §15 п.7). Library → API:
# Library ID + API Key. Library → Security: включить Token Authentication и
# "Block direct URL file access", скопировать Token Authentication Key.
# BUNNY_WEBHOOK_KEY — любая длинная случайная строка; её же указать в
# Library → Webhook как ?key=<...>. BUNNY_PLAYBACK_TTL — время жизни
# подписанного HLS-URL в секундах (по умолчанию 6 ч).
BUNNY_STREAM_LIBRARY_ID=123456
BUNNY_STREAM_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BUNNY_STREAM_CDN_HOSTNAME=vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_STREAM_TOKEN_KEY=xxxxxxxxxxxxxxxxxxxx
BUNNY_WEBHOOK_KEY=some-long-random-string
BUNNY_PLAYBACK_TTL=21600
